# ============================================
# BluePrint - Development Dockerfile
# ============================================
# Hot-reload development environment

# Pin to Bun 1.1.x minor for reproducible dev environments
FROM oven/bun:1.1-alpine
RUN apk add --no-cache libc6-compat openssl

WORKDIR /app

# Copy package files
COPY package.json bun.lock ./
COPY prisma ./prisma/

# Install dependencies (Bun with frozen lockfile for reproducibility)
RUN bun install --frozen-lockfile

# Generate Prisma Client
RUN bunx prisma generate

# Copy application code
COPY . .

# Create necessary directories and set ownership
RUN mkdir -p /app/db /app/uploads && \
    addgroup -g 1001 -S nodejs && \
    adduser -S nextjs -u 1001 -G nodejs && \
    chown -R nextjs:nodejs /app/db /app/uploads

# SECURITY: Run as non-root user (consistent with production Dockerfile)
USER nextjs

# Expose port
EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Start development server with webpack
CMD ["bun", "run", "dev"]
