# Auto-detect text files and normalize line endings
* text=auto

# Windows batch files MUST use CRLF line endings
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts MUST use LF line endings
*.sh text eol=lf

# Keep these as-is (binary)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.db binary
*.sqlite binary
