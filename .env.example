# ============================================
# BluePrint SaaS - Environment Variables Example
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# SECURITY: Never commit .env to version control!

# ============================================
# Database (Required for Docker Compose)
# ============================================
# PostgreSQL password — MUST be set for docker-compose
DATABASE_PASSWORD=change_me_to_a_secure_password

# Database connection string
# For local development (SQLite):
DATABASE_URL="file:./db/dev.db"
# For Docker Compose (PostgreSQL):
# DATABASE_URL=postgresql://blueprint:${DATABASE_PASSWORD}@postgres:5432/blueprint?schema=public

# ============================================
# Authentication & Encryption (Required)
# ============================================
# JWT secret for authentication tokens — generate with: openssl rand -base64 32
JWT_SECRET=change_me_to_a_random_base64_string

# Encryption key for sensitive data (64 hex chars = 256 bits) — generate with: openssl rand -hex 32
ENCRYPTION_KEY=change_me_to_a_random_64_char_hex_string

# ============================================
# Application
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# Demo Mode (Development Only)
# ============================================
# Set to 'true' to enable demo accounts and auto-fill on login page
# CRITICAL: Must be 'false' or unset in production
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true

# Override individual demo passwords (optional, defaults are in src/lib/demo-credentials.ts)
# DEMO_ADMIN_PASSWORD=
# DEMO_PM_PASSWORD=
# DEMO_ENGINEER_PASSWORD=
# DEMO_STRUCT_PASSWORD=
# DEMO_ELEC_PASSWORD=
# DEMO_SITE_PASSWORD=
# DEMO_MEP_PASSWORD=
# DEMO_DRAFT_PASSWORD=
# DEMO_ACCOUNTANT_PASSWORD=
# DEMO_SECRETARY_PASSWORD=
# DEMO_HR_PASSWORD=
# DEMO_VIEWER_PASSWORD=

# ============================================
# Redis (Required for Docker Compose)
# ============================================
REDIS_PASSWORD=change_me_to_a_secure_password

# Redis URL (Docker Compose overrides this)
# REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# ============================================
# Tax & Business
# ============================================
TAX_RATE=0.05

# ============================================
# Multi-tenant Mode
# ============================================
MULTI_TENANT=false

# ============================================
# Cache Settings
# ============================================
CACHE_DEFAULT_TTL=300
CACHE_KEY_PREFIX=blueprint:

# ============================================
# File Storage
# ============================================
STORAGE_TYPE=local
UPLOAD_DIR=./uploads

# ============================================
# Node Environment
# ============================================
NODE_ENV=development
PORT=3000

# ============================================
# Audit Logging
# ============================================
AUDIT_LOG_ENABLED=true

# ============================================
# JWT Expiration
# ============================================
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# SMTP (Optional — for email features)
# ============================================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# ============================================
# Stripe (Optional — for billing features)
# ============================================
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ============================================
# Sentry (Optional — for error tracking)
# ============================================
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
