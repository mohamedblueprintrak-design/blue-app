# ============================================
# BluePrint SaaS - Environment Variables
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# SECURITY: Never commit .env to version control!
# ============================================

# --------------------------------------------
# CORE (Required)
# --------------------------------------------

# Database connection string
# SQLite (default for development): file:./dev.db
# PostgreSQL (production): postgresql://user:password@host:5432/dbname
DATABASE_URL="file:./dev.db"

# JWT secret for authentication tokens (min 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=<generate-with-openssl-rand-base64-32>

# Encryption key for sensitive data (64 hex characters = 32 bytes)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=<generate-with-openssl-rand-hex-32>

# --------------------------------------------
# APPLICATION (Required)
# --------------------------------------------

# Public URL of the application (used for email links, CORS, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --------------------------------------------
# DATABASE (Docker/PostgreSQL only)
# --------------------------------------------

# PostgreSQL password (required for docker-compose)
DATABASE_PASSWORD=<generate-a-strong-password>

# --------------------------------------------
# REDIS (Optional - enables caching & rate limiting)
# --------------------------------------------

# Redis connection URL
REDIS_URL=redis://localhost:6379

# Redis password (for docker-compose)
REDIS_PASSWORD=dev_redis_password

# Redis database number (default: 0)
REDIS_DB=0

# Redis key prefix (default: blueprint:)
REDIS_PREFIX=blueprint:

# --------------------------------------------
# SMTP / EMAIL (Optional - enables email features)
# --------------------------------------------

# Email Configuration
# Provider: "smtp" (default) or "resend"
EMAIL_PROVIDER=smtp

# SMTP Configuration (when EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@blueprint.ae

# Alternative: Resend (when EMAIL_PROVIDER=resend)
# Get your API key at https://resend.com
RESEND_API_KEY=

# --------------------------------------------
# STRIPE (Optional - enables payment features)
# --------------------------------------------

# Stripe secret key (sk_test_... or sk_live_...)
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=

# --------------------------------------------
# AI ASSISTANT (Optional - enables AI chat features)
# --------------------------------------------

# Z-AI API base URL
ZAI_BASE_URL=

# Z-AI API key
ZAI_API_KEY=

# Z-AI chat ID for conversations
ZAI_CHAT_ID=

# Z-AI user ID
ZAI_USER_ID=

# Z-AI authentication token
ZAI_TOKEN=

# OpenAI API key (for GPT-4o, GPT-4o-mini, etc.)
OPENAI_API_KEY=

# Google Gemini API key
GEMINI_API_KEY=

# DeepSeek API key
DEEPSEEK_API_KEY=

# Mistral API key
MISTRAL_API_KEY=

# OpenRouter API key (aggregator for multiple models)
OPENROUTER_API_KEY=

# xAI Grok API key
XAI_API_KEY=

# Groq API key (fast inference)
GROQ_API_KEY=

# HuggingFace API key
HUGGINGFACE_API_KEY=

# --------------------------------------------
# MONITORING (Optional - enables Sentry error tracking)
# --------------------------------------------

# Sentry DSN for error reporting (NEXT_PUBLIC_ prefix exposes to browser)
NEXT_PUBLIC_SENTRY_DSN=

# Enable Sentry in development (default: disabled)
SENTRY_ENABLE_DEV=

# Application version (for Sentry release tracking)
NEXT_PUBLIC_APP_VERSION=1.0.0

# --------------------------------------------
# WEBSOCKET (Optional - enables real-time features)
# --------------------------------------------

# WebSocket server URL (NEXT_PUBLIC_ prefix exposes to browser)
NEXT_PUBLIC_WEBSOCKET_URL=

# --------------------------------------------
# MULTI-TENANT (Optional)
# --------------------------------------------

# Enable multi-tenant mode for organization-based data isolation
# When true, users without an organizationId cannot see cross-tenant data
# When false (default), all authenticated users can see all data (single-tenant)
MULTI_TENANT=false

# --------------------------------------------
# SECURITY (Optional)
# --------------------------------------------

# CORS allowed origins (comma-separated)
CORS_ORIGINS=

# Cron job secret (for /api/cron endpoints)
CRON_SECRET=

# JWT token expiration (default: 15m)
JWT_EXPIRES_IN=15m

# JWT refresh token expiration (default: 7d)
JWT_REFRESH_EXPIRES_IN=7d

# CSRF protection secret
CSRF_SECRET=

# Rate limiting: max requests per window (default: 100)
RATE_LIMIT_MAX=100

# Rate limiting: time window in seconds (default: 60)
RATE_LIMIT_WINDOW=60

# Audit logging enabled (default: true in production)
AUDIT_LOG_ENABLED=true

# --------------------------------------------
# BUSINESS (Optional)
# --------------------------------------------

# Tax rate for invoices (default: 0.05 = 5% UAE VAT)
TAX_RATE=0.05

# Demo mode (default: true in development, false in production)
DEMO_MODE=true

# Client-side demo mode flag (NEXT_PUBLIC_ prefix exposes to browser)
# Must mirror DEMO_MODE for login page auto-fill to work
NEXT_PUBLIC_DEMO_MODE=true

# Cache default TTL in seconds
CACHE_DEFAULT_TTL=300

# Cache key prefix
CACHE_KEY_PREFIX=blueprint:

# --------------------------------------------
# FILE STORAGE (Optional - defaults to local storage)
# --------------------------------------------

# Storage type: "local" (default) or "s3"
STORAGE_TYPE=local

# Local storage directory (default: ./uploads)
UPLOAD_DIR=./uploads

# S3 Configuration (required if STORAGE_TYPE=s3)
# S3 endpoint URL (leave empty for AWS S3, set for MinIO/DO Spaces)
S3_ENDPOINT=
# S3 bucket name
S3_BUCKET=
# S3 region (default: us-east-1)
S3_REGION=
# S3 access key ID
S3_ACCESS_KEY=
# S3 secret access key
S3_SECRET_KEY=

# --------------------------------------------
# QUEUE (Optional - enables background job processing)
# --------------------------------------------

# Redis URL for BullMQ job queue (same as REDIS_URL above)
# REDIS_URL=redis://localhost:6379

# --------------------------------------------
# NODE ENVIRONMENT
# --------------------------------------------

# Node environment (development | production | test)
NODE_ENV=development

# Application port (default: 3000)
PORT=3000
