// ============================================
// DATABASE PROVIDER CONFIGURATION
// ============================================
// This schema is configured for PostgreSQL (production-grade).
//
// FOR LOCAL DEVELOPMENT WITH SQLite:
//   1. Change provider below to "sqlite"
//   2. Remove all @db.Text and @db.VarChar() annotations
//   3. Set DATABASE_URL in .env to "file:./db/custom.db"
//   4. Run: npx prisma db push
//   5. Run: npx tsx prisma/seed.ts
//
// FOR PRODUCTION WITH PostgreSQL:
//   1. Keep provider as "postgresql" (default)
//   2. Set DATABASE_URL in .env to postgresql://user:pass@host:5432/db
//   3. Run: npx prisma migrate deploy
//   4. Run: npx tsx prisma/seed.ts
//
// NOTE: PostgreSQL natively supports enums (defined below).
//       With SQLite, enums are stored as strings.
// NOTE: @db.Text and @db.VarChar() annotations are PostgreSQL-specific.
//       They must be removed when switching to SQLite provider.
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS (SaaS Multi-tenant) ====================

/// User roles in the system
enum UserRole {
  ADMIN // Full system access
  MANAGER // Project management access
  PROJECT_MANAGER // Project-level management
  ENGINEER // Technical access
  DRAFTSMAN // Drafting and drawing access
  ACCOUNTANT // Financial access
  HR // Human resources access
  SECRETARY // Office management and documents
  VIEWER // Read-only access
  @@map("user_role")
}

/// Permission types for fine-grained access control
enum Permission {
  // Project permissions
  PROJECT_CREATE
  PROJECT_READ
  PROJECT_UPDATE
  PROJECT_DELETE

  // Task permissions
  TASK_CREATE
  TASK_READ
  TASK_UPDATE
  TASK_DELETE

  // Client permissions
  CLIENT_CREATE
  CLIENT_READ
  CLIENT_UPDATE
  CLIENT_DELETE

  // Invoice permissions
  INVOICE_CREATE
  INVOICE_READ
  INVOICE_UPDATE
  INVOICE_DELETE

  // User management permissions
  USER_CREATE
  USER_READ
  USER_UPDATE
  USER_DELETE

  // Settings permissions
  SETTINGS_READ
  SETTINGS_UPDATE

  // Reports permissions
  REPORTS_READ
  REPORTS_EXPORT

  // Budget permissions
  BUDGET_MANAGE

  // Document permissions
  DOCUMENT_CREATE
  DOCUMENT_READ
  DOCUMENT_UPDATE
  DOCUMENT_DELETE
  @@map("permission")
}

/// Subscription status
enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  @@map("subscription_status")
}

/// Payment status for SaaS subscriptions
enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  @@map("payment_status")
}

/// Subscription interval
enum SubscriptionInterval {
  MONTH
  YEAR
  @@map("subscription_interval")
}

/// Two-factor challenge type
enum TwoFactorChallengeType {
  TOTP
  BACKUP
  SMS
  @@map("two_factor_challenge_type")
}

/// Task type for categorization
enum TaskType {
  STANDARD // Regular task
  GOVERNMENTAL // Government entity
  MANDATORY // Mandatory for licensing
  CLIENT // Client approval
  INTERNAL // Internal task
  @@map("task_type")
}

/// SLA breach status for monitoring
enum SLABreachStatus {
  WARNING // Warning before SLA expires
  BREACHED // SLA exceeded
  CRITICAL // Critical breach
  RESOLVED // Resolved
  @@map("sla_breach_status")
}

/// Government approval status
enum GovernmentApprovalStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
  @@map("government_approval_status")
}

/// Utility connection status
enum UtilityConnectionStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  @@map("utility_connection_status")
}

// ==================== USERS & AUTH ====================

model User {
  id                  String    @id @default(cuid())
  email               String    @unique @db.VarChar(255)
  password            String    @default("") // Auth service always hashes passwords before saving; empty default prevents accidental login
  name                String    @default("")
  phone               String    @default("") @db.VarChar(100)
  avatar              String    @default("")
  role                UserRole  @default(VIEWER)
  department          String    @default("")
  position            String    @default("")
  isActive            Boolean   @default(true)
  lastLogin           DateTime?
  organizationId      String? // SaaS multi-tenant organization
  deletedAt           DateTime? // Soft delete
  // Email verification
  emailVerified       DateTime?
  // NOTE: verifyToken and verifyTokenExpiry fields were removed.
  // Email verification now uses the separate EmailVerificationToken model
  // which stores hashed tokens — never plaintext.
  // Password reset uses the separate PasswordResetToken model.
  passwordChangedAt   DateTime? // When password was last changed - used to invalidate tokens
  // 2FA — the User model's twoFactorEnabled field is kept for quick lookups.
  // The actual secret and backup codes are stored in the TwoFactorSecret model.
  twoFactorEnabled    Boolean   @default(false)
  // NOTE: twoFactorSecret and backupCodes fields were removed from User model.
  // They are now stored exclusively in the TwoFactorSecret model where
  // the secret is AES-256-GCM encrypted and backup codes are SHA-256 hashed.
  // Account lockout
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  preferences         String?   @default("{}")
  googleId            String?   @unique // Google OAuth sub ID — for social login
  microsoftId         String?   @unique // Microsoft OAuth sub ID — for social login
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization           Organization?         @relation(fields: [organizationId], references: [id])
  projects               ProjectAssignment[]
  tasks                  Task[]
  assignedDefects        Defect[]
  assignedWorkflowStages WorkflowStage[]       @relation("WorkflowStageAssignee")
  assignedWorkflowSteps  WorkflowStep[]        @relation("WorkflowStepAssignee")
  activities             ActivityLog[]
  leaves                 Leave[]
  createdProjects        Project[]             @relation("CreatedProjects")
  managedProjects        Project[]             @relation("ProjectManager")
  rfisFrom               RFI[]                 @relation("RFIFrom")
  rfisTo                 RFI[]                 @relation("RFITo")
  riskActions            RiskAction[]
  meetingAttendee        MeetingAttendee[]
  notifications          Notification[]
  sentTransmittals       Transmittal[]         @relation("TransmittalFrom")
  knowledgeArticles      KnowledgeArticle[]
  employee               Employee?
  approvedPayments       Payment[]             @relation("PaymentApprover")
  approvedLeaves         Leave[]               @relation("LeaveApprover")
  approvedTimesheets     Timesheet[]           @relation("TimesheetApprover")
  uploadedDocuments      Document[]            @relation("DocumentUploader")
  projectComments        ProjectComment[]
  comments               TaskComment[]
  tenders                Tender[]              @relation("TenderAssignee")
  commissions            Commission[]          @relation("CommissionUser")
  approvedCommissions    Commission[]          @relation("CommissionApprover")
  referrals              Referral[]            @relation("ReferralReferrer")
  notificationSettings   NotificationSettings?
  aiChatConversations    AIChatConversation[]
  refreshTokens          RefreshToken[]
  paymentCreated         Payment[]             @relation("PaymentCreator")
  paymentUpdated         Payment[]             @relation("PaymentUpdater")
  budgetCreated          Budget[]              @relation("BudgetCreator")
  budgetUpdated          Budget[]              @relation("BudgetUpdater")
  proposalCreated        Proposal[]            @relation("ProposalCreator")
  proposalUpdated        Proposal[]            @relation("ProposalUpdater")
  invoicePayments        InvoicePayment[]

  @@index([organizationId])
  @@index([deletedAt])
  @@index([name])
  @@index([role])
  @@index([isActive])
}

// ==================== REFRESH TOKENS ====================

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // SHA-256 hash of the token
  expiresAt DateTime
  revokedAt DateTime? // When token was explicitly revoked
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

// ==================== COMPANY SETTINGS ====================

model CompanySettings {
  id             String   @id @default(cuid())
  name           String   @default("مكتب الاستشارات الهندسية")
  nameEn         String   @default("Engineering Consultancy Office")
  logo           String   @default("")
  email          String   @default("") @db.VarChar(255)
  phone          String   @default("") @db.VarChar(100)
  address        String   @default("") @db.Text
  taxNumber      String   @default("")
  currency       String   @default("AED")
  timezone       String   @default("Asia/Dubai")
  workingDays    String   @default("sat,sun,mon,tue,wed,thu") // comma-separated UAE work week (Saturday-Thursday)
  workingHours   String   @default("08:00-17:00")
  organizationId String? // SaaS multi-tenant organization
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

// ==================== PROJECTS ====================

model Project {
  id                    String    @id @default(cuid())
  number                String    @unique
  name                  String    @default("")
  nameEn                String    @default("")
  clientId              String
  contractorId          String?
  location              String    @default("")
  latitude              Float?
  longitude             Float?
  plotNumber            String    @default("")
  type                  String    @default("villa") // villa, building, commercial, industrial
  status                String    @default("active") // active, completed, delayed, on_hold, cancelled
  progress              Float     @default(0)
  budget                Decimal   @default(0)
  contractValue         Decimal   @default(0) // Total contract value
  paymentMethod         String    @default("") // cash, cheque, transfer, installments
  paymentSchedule       String    @default("") @db.Text // JSON: [{milestone,amount,percentage,dueDate,status}]
  expectedDuration      Int       @default(0) // Expected duration in days
  startDate             DateTime?
  endDate               DateTime?
  expectedEndDate       DateTime? // Expected delivery date
  actualStartDate       DateTime?
  actualEndDate         DateTime?
  contractDate          DateTime?
  description           String    @default("") @db.Text
  municipalityChecklist String    @default("") @db.Text // JSON: [{id,label,checked,stage}]
  managerId             String?
  createdById           String
  organizationId        String? // SaaS multi-tenant organization
  deletedAt             DateTime? // Soft delete
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  client                     Client                       @relation(fields: [clientId], references: [id])
  contractor                 Contractor?                  @relation("ProjectContractor", fields: [contractorId], references: [id])
  createdBy                  User                         @relation("CreatedProjects", fields: [createdById], references: [id])
  manager                    User?                        @relation("ProjectManager", fields: [managerId], references: [id])
  organization               Organization?                @relation(fields: [organizationId], references: [id])
  assignments                ProjectAssignment[]
  tasks                      Task[]
  stages                     ProjectStage[]
  muniRejections             MunicipalRejection[]
  govApprovals               GovApproval[]
  boqItems                   BOQItem[]
  schedulePhases             SchedulePhase[]
  invoices                   Invoice[]
  contracts                  Contract[]
  proposals                  Proposal[]
  bids                       Bid[]
  budgets                    Budget[]
  commissions                Commission[]
  referrals                  Referral[]
  siteVisits                 SiteVisit[]
  defects                    Defect[]
  siteDiaries                SiteDiary[]
  rfis                       RFI[]
  submittals                 Submittal[]
  changeOrders               ChangeOrder[]
  transmittals               Transmittal[]
  risks                      Risk[]
  meetings                   Meeting[]
  clientInteractions         ClientInteraction[]
  documents                  Document[]
  purchaseOrders             PurchaseOrder[]
  inventoryItems             InventoryItem[]
  payments                   Payment[]
  comments                   ProjectComment[]
  municipalityCorrespondence MunicipalityCorrespondence[]
  approvals                  Approval[]
  notifications              Notification[]
  activityLogs               ActivityLog[]
  knowledgeArticles          KnowledgeArticle[]
  designPhases               DesignPhase[]
  buildingInspections        BuildingInspection[]
  supervisionChecklists      SupervisionChecklist[]
  violations                 Violation[]
  workflow                   ProjectWorkflow?
  retainages                 Retainage[]
  guaranteeLetters           GuaranteeLetter[]
  progressClaims             ProgressClaim[]
  timesheets                 Timesheet[]
  timesheetEntries           TimesheetEntry[]

  @@index([clientId])
  @@index([status])
  @@index([contractorId])
  @@index([organizationId])
  @@index([deletedAt])
  @@index([createdById])
  @@index([managerId])
  @@index([organizationId, deletedAt])
  @@index([organizationId, status, deletedAt])
}

// ==================== MUNICIPALITY CORRESPONDENCE ====================

model MunicipalityCorrespondence {
  id                 String    @id @default(cuid())
  projectId          String
  referenceNumber    String    @default("") @db.VarChar(100)
  municipality       String    @default("")
  correspondenceType String    @default("SUBMISSION") // SUBMISSION, RESPONSE, REJECTION, APPROVAL, INQUIRY, AMENDMENT
  subject            String    @default("") @db.Text
  content            String    @default("") @db.Text
  submissionDate     DateTime?
  responseDate       DateTime?
  status             String    @default("PENDING") // PENDING, UNDER_REVIEW, APPROVED, REJECTED, AMENDMENT_REQUIRED
  notes              String    @default("") @db.Text
  responseNotes      String    @default("") @db.Text
  organizationId     String? // SaaS multi-tenant organization
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([projectId])
  @@index([status])
  @@index([organizationId])
  deletedAt      DateTime? // Soft delete
  @@index([deletedAt])
}

model ProjectComment {
  id             String   @id @default(cuid())
  content        String
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([projectId])
  @@index([organizationId])
  deletedAt      DateTime? // Soft delete
  @@index([deletedAt])
}

model ProjectAssignment {
  id             String   @id @default(cuid())
  projectId      String
  userId         String
  role           String   @default("team_member")
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@index([organizationId])
  deletedAt      DateTime? // Soft delete
  @@index([deletedAt])
}

// ==================== PROJECT STAGES ====================

model ProjectStage {
  id             String   @id @default(cuid())
  projectId      String
  department     String // architectural, structural, mep_electrical, mep_plumbing, mep_water, mep_civil_defense, mep_telecom
  stageName      String   @default("")
  stageOrder     Int      @default(0)
  status         String   @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, SUBMITTED, APPROVED, REJECTED
  engineerId     String?
  notes          String   @default("") @db.Text
  organizationId String? // SaaS multi-tenant organization
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([projectId, department])
  @@index([status])
  @@index([organizationId])
}

model MunicipalRejection {
  id                String    @id @default(cuid())
  projectId         String
  department        String
  count             Int       @default(0)
  notes             String    @default("") @db.Text
  lastRejectionDate DateTime?
  organizationId    String? // SaaS multi-tenant organization
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@unique([projectId, department])
  @@index([organizationId])
}

// ==================== GOVERNMENT APPROVALS ====================

model GovApproval {
  id             String                   @id @default(cuid())
  projectId      String
  authority      String // MUN, FEWA, ETISALAT, CIVIL_DEFENSE
  status         GovernmentApprovalStatus @default(PENDING)
  submissionDate DateTime?
  approvalDate   DateTime?
  rejectionCount Int                      @default(0)
  notes          String                   @default("") @db.Text
  organizationId String? // SaaS multi-tenant organization
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@unique([projectId, authority])
  @@index([status])
  @@index([organizationId])
}

// ==================== CLIENTS ====================

model Client {
  id             String    @id @default(cuid())
  // Basic Info
  clientType     String    @default("individual") // individual, company, government
  name           String    @default("")
  nameEn         String    @default("")
  company        String    @default("")
  companyEn      String    @default("")
  idNumber       String    @default("") // UAE ID or Commercial Registration
  nationality    String    @default("")
  idPhoto        String    @default("") // ID photo file path
  email          String    @default("") @db.VarChar(255) // Email uniqueness enforced at application level (many clients may have empty email)
  phone          String    @default("") @db.VarChar(100)
  whatsapp       String    @default("") @db.VarChar(100) // separate WhatsApp number
  extraPhone     String    @default("") @db.VarChar(100) // additional phone
  address        String    @default("") @db.Text
  fullAddress    String    @default("") @db.Text // JSON: {emirate,city,area,street,building,unit}
  taxNumber      String    @default("")
  creditLimit    Decimal   @default(0)
  paymentTerms   String    @default("")
  // Services & Project Info
  servicesWanted String    @default("") @db.Text // JSON array: ["consultation","design","license",...]
  projectType    String    @default("") // villa, apartment, commercial, industrial, residential_building, medical
  serviceNotes   String? @db.Text // legacy: additional details
  // Land Details
  landLocation   String    @default("")
  landArea       String    @default("")
  plotNumber     String    @default("")
  planNumber     String    @default("")
  landDocuments  String    @default("") @db.Text // JSON array: [{type:"survey",path:...},...]
  notes          String    @default("") @db.Text
  // Referral
  referralSource String    @default("") // social_media, referral, website, walk_in, advertisement, other
  referralDetail String    @default("")
  // Credit & Status
  creditUsed     Decimal   @default(0)
  isActive       Boolean   @default(true)
  organizationId String? // SaaS multi-tenant organization
  createdById    String?
  deletedAt      DateTime? // Soft delete
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  projects            Project[]
  invoices            Invoice[]
  organization        Organization?        @relation(fields: [organizationId], references: [id])
  contracts           Contract[]
  proposals           Proposal[]
  interactions        ClientInteraction[]
  buildingInspections BuildingInspection[]

  @@unique([email, organizationId], name: "client_email_org_unique")
  @@unique([idNumber, organizationId], name: "client_idnumber_org_unique")
  @@index([organizationId])
  @@index([email]) // Index for email lookups
  @@index([idNumber]) // Index for ID number lookups
  @@index([deletedAt])
  @@index([isActive])
  @@index([createdById])
  @@index([organizationId, deletedAt])
  @@index([organizationId, isActive, deletedAt])
}

model ClientInteraction {
  id             String   @id @default(cuid())
  projectId      String
  clientId       String
  type           String   @default("meeting") // meeting, call, email
  date           DateTime
  subject        String   @default("") @db.Text
  description    String   @default("") @db.Text
  outcome        String   @default("") @db.Text
  organizationId String? // SaaS multi-tenant organization
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project      Project       @relation(fields: [projectId], references: [id])
  client       Client        @relation(fields: [clientId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([clientId])
  @@index([projectId])
  @@index([date])
  @@index([organizationId])
}

// ==================== TASKS ====================

model Task {
  id             String    @id @default(cuid())
  projectId      String?
  title          String    @default("")
  titleAr        String    @default("")
  description    String    @default("") @db.Text
  assigneeId     String?
  priority       String    @default("normal") // normal, medium, high, urgent
  status         String    @default("todo") // todo, in_progress, review, done, cancelled
  startDate      DateTime?
  dueDate        DateTime?
  endDate        DateTime?
  progress       Float     @default(0)
  slaDays        Int?
  slaStartDate   DateTime?
  slaWarningDays Int       @default(3)
  slaBreachedAt  DateTime?
  taskType       TaskType  @default(STANDARD)
  dependencies   String? @db.Text // JSON array of task IDs
  color          String    @default("")
  estimatedHours Float?
  actualHours    Float?
  isMilestone    Boolean   @default(false)
  order          Int       @default(0)
  organizationId String? // SaaS multi-tenant organization
  createdById    String?
  deletedAt      DateTime? // Soft delete
  parentId       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project      Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee     User?         @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  subtasks     Task[]        @relation("TaskSubtask")
  parent       Task?         @relation("TaskSubtask", fields: [parentId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  comments     TaskComment[]

  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
  @@index([organizationId])
  @@index([dueDate])
  @@index([projectId, status])
  @@index([assigneeId, status])
  @@index([status, dueDate])
  @@index([deletedAt])
  @@index([organizationId, deletedAt])
  @@index([organizationId, status, deletedAt])
}

// ==================== TASK COMMENTS ====================

model TaskComment {
  id             String   @id @default(cuid())
  content        String
  taskId         String
  userId         String
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  deletedAt      DateTime? // Soft delete
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([taskId])
  @@index([organizationId])
  @@index([deletedAt])
}

// ==================== CONTRACTS ====================

model Contract {
  id             String    @id @default(cuid())
  number         String    @default("")
  title          String    @default("")
  clientId       String
  projectId      String
  value          Decimal   @default(0)
  type           String    @default("engineering_services") // engineering_services, construction, consulting, maintenance
  status         String    @default("draft") // draft, pending_signature, active, expired, completed
  signedByName   String    @default("")
  signedByTitle  String    @default("")
  signature      String    @default("")
  startDate      DateTime?
  deletedAt      DateTime? // Soft delete
  endDate        DateTime?
  organizationId String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  client       Client              @relation(fields: [clientId], references: [id])
  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization?       @relation(fields: [organizationId], references: [id])
  amendments   ContractAmendment[]
  documents    Document[]

  @@index([organizationId])
  @@index([projectId])
  @@index([clientId])
  @@index([deletedAt])
  @@index([status])
}

model ContractAmendment {
  id          String   @id @default(cuid())
  contractId  String
  number      String   @default("")
  description String   @default("") @db.Text
  date        DateTime
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([status])
}

// ==================== INVOICES ====================

model Invoice {
  id             String    @id @default(cuid())
  number         String    @default("")
  clientId       String
  projectId      String
  issueDate      DateTime
  dueDate        DateTime
  subtotal       Decimal   @default(0)
  tax            Decimal   @default(0)
  taxRate        Decimal   @default(0) // Tax percentage
  total          Decimal   @default(0)
  paidAmount     Decimal   @default(0)
  remaining      Decimal   @default(0)
  status         String    @default("draft") // draft, sent, partially_paid, paid, overdue, cancelled
  organizationId String? // SaaS multi-tenant organization
  createdById    String?
  deletedAt      DateTime? // Soft delete
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  client          Client           @relation(fields: [clientId], references: [id])
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items           InvoiceItem[]
  invoicePayments InvoicePayment[]
  payments        Payment[]
