model ProjectStage {
  id              String   @id @default(cuid())
  projectId       String
  department      ProjectDepartment @default(ARCHITECTURAL)
  stageName       String?
  stageOrder      Int      @default(0)
  status          ProjectStageStatus @default(NOT_STARTED)
  engineerId      String?
  notes           String?
  organizationId  String? // TODO: Make required after data migration
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([projectId, department])
  @@index([status])
  @@index([organizationId])
}

model MunicipalRejection {
  id                 String    @id @default(cuid())
  projectId          String
  department         ProjectDepartment
  count              Int       @default(0)
  notes              String?
  lastRejectionDate  DateTime?
  organizationId     String? // TODO: Make required after data migration
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  project            Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization       Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([projectId, department])
  @@index([organizationId])
}

// ==================== GOVERNMENT APPROVALS ====================

model GovApproval {
