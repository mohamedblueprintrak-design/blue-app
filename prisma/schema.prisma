// ============================================
// DATABASE PROVIDER CONFIGURATION
// ============================================
// This schema is configured for SQLite.
//
// SETUP:
//   1. Set DATABASE_URL in .env to "file:./db/custom.db"
//   2. Run: npx prisma db push
//   3. Run: npx tsx prisma/seed.ts
//
// NOTE: With SQLite, enums are stored as strings.
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

