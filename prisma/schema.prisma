  type            String?
  budget          Decimal   @default(0)
  spent           Decimal   @default(0)
  leads           Int       @default(0)
  conversions     Int       @default(0)
  startDate       DateTime?
  endDate         DateTime?
  status          CampaignStatus @default(ACTIVE)
  notes           String?
  organizationId  String? // TODO: Make required after data migration
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([organizationId])
}

// ==================== WORKFLOW MANAGEMENT ====================

model WorkflowTemplate {
  id              String   @id @default(cuid())
  name            String?
  nameEn          String?
  projectType     ProjectType?
  description     String?
  isActive        Boolean  @default(true)
  organizationId  String? // TODO: Make required after data migration
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization?           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  stages          WorkflowTemplateStage[]
  projects        ProjectWorkflow[]

  @@index([organizationId])
}

model WorkflowTemplateStage {
  id              String   @id @default(cuid())
  templateId      String
  name            String?
  nameEn          String?
  order           Int      @default(0)
  durationDays    Int      @default(0)
  isParallel      Boolean  @default(false)
  isOptional      Boolean  @default(false)
  organizationId  String? // TODO: Make required after data migration
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  template        WorkflowTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  steps           WorkflowTemplateStep[]
  organization    Organization?          @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([templateId, order])
  @@index([organizationId])
}

model WorkflowTemplateStep {
  id                String   @id @default(cuid())
  stageId           String
  name              String?
  nameEn            String?
  order             Int      @default(0)
  assignedRole      String?
  isRequired        Boolean  @default(true)
  requiresApproval  Boolean  @default(false)
  autoComplete      Boolean  @default(false)
  onCompleteAction  String   @default("next_step")
  daysToComplete    Int      @default(0)
  organizationId    String? // TODO: Make required after data migration
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  stage             WorkflowTemplateStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  organization      Organization?        @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([stageId, order])
  @@index([organizationId])
}

model ProjectWorkflow {
  id              String    @id @default(cuid())
  projectId       String    @unique
  templateId      String?
  currentStageId  String?
  status          WorkflowTemplateStatus @default(ACTIVE)
  progress        Float     @default(0)
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  organizationId  String? // TODO: Make required after data migration
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template        WorkflowTemplate? @relation(fields: [templateId], references: [id])
  stages          WorkflowStage[]

  @@index([projectId])
  @@index([status])
  @@index([templateId])
  @@index([organizationId])
}

model WorkflowStage {
  id               String    @id @default(cuid())
  workflowId       String
  templateStageId  String?
  name             String?
  nameEn           String?
  order            Int       @default(0)
  status           WorkflowStageStatus @default(PENDING)
  startDate        DateTime?
  dueDate          DateTime?
  completedDate    DateTime?
  assigneeId       String?
  notes            String?
  organizationId   String? // TODO: Make required after data migration
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  assignee         User?           @relation("WorkflowStageAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  workflow         ProjectWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  steps            WorkflowStep[]
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([workflowId, order])
  @@index([status])
  @@index([dueDate])
  @@index([assigneeId])
  @@index([organizationId])
}

model WorkflowStep {
  id              String    @id @default(cuid())
  stageId         String
  templateStepId  String?
  name            String?
  nameEn          String?
  order           Int       @default(0)
  status          WorkflowStepStatus    @default(LOCKED)
  assigneeId      String?
  assignedRole    String?
  startDate       DateTime?
  dueDate         DateTime?
  completedDate   DateTime?
  action          String?
  notes           String?
  returnReason    String?
  severity        WorkflowStepSeverity @default(NORMAL)
  organizationId  String? // TODO: Make required after data migration
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  assignee        User?         @relation("WorkflowStepAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  stage           WorkflowStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([stageId, order])
  @@index([status])
  @@index([dueDate])
  @@index([assigneeId])
  @@index([organizationId])
}

// ==================== SAAS MULTI-TENANT MODELS ====================

// Organization (Tenant)
model Organization {
  id                          String    @id @default(cuid())
  name                        String
  slug                        String    @unique
  logo                        String?
  description                 String?
  website                     String?
  phone                       String?
  email                       String?
  address                     String?
  taxNumber                   String?
  currency                    Currency    @default(AED)
  timezone                    String    @default("Asia/Dubai")
  locale                      String    @default("ar")
  isActive                    Boolean   @default(true)
  planId                      String? // Current plan ID
  stripeCustomerId            String? @unique // Stripe customer ID for billing
  deletedAt                   DateTime? // Soft delete
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  plan                        Plan?                        @relation(fields: [planId], references: [id])
  users                       User[]
  subscriptions               Subscription[]
  projects                    Project[]
  tasks                       Task[]
  invoices                    Invoice[]
  clients                     Client[]
  payments                    Payment[]
  budgets                     Budget[]
  proposals                   Proposal[]
  contracts                   Contract[]
  bids                        Bid[]
  defects                     Defect[]
  risks                       Risk[]
  documents                   Document[]
  meetings                    Meeting[]
  buildingInspections         BuildingInspection[]
  purchaseOrders              PurchaseOrder[]
  tenders                     Tender[]
  siteVisits                  SiteVisit[]
  schedulePhases              SchedulePhase[]
  contractors                 Contractor[]
  equipment                   Equipment[]
  // --- New multi-tenant relations (organizationId added) ---
  companySettings             CompanySettings[]
  municipalityCorrespondence  MunicipalityCorrespondence[]
  projectStages               ProjectStage[]
  municipalRejections         MunicipalRejection[]
  govApprovals                GovApproval[]
  clientInteractions          ClientInteraction[]
  siteDiaries                 SiteDiary[]
  rfis                        RFI[]
  submittals                  Submittal[]
  changeOrders                ChangeOrder[]
  transmittals                Transmittal[]
  boqItems                    BOQItem[]
  employees                   Employee[]
  attendance                  Attendance[]
  leaves                      Leave[]
  suppliers                   Supplier[]
  inventoryItems              InventoryItem[]
  quoteRequests               QuoteRequest[]
  knowledgeArticles           KnowledgeArticle[]
  notifications               Notification[]
  activityLogs                ActivityLog[]
  approvals                   Approval[]
  designPhases                DesignPhase[]
  supervisionChecklists       SupervisionChecklist[]
  violations                  Violation[]
  commissions                 Commission[]
  referrals                   Referral[]
  marketingCampaigns          MarketingCampaign[]
  workflowTemplates           WorkflowTemplate[]
  securityAuditLogs           SecurityAuditLog[]
  contractorEvaluations       ContractorEvaluation[]
  automations                 Automation[]
  projectComments             ProjectComment[]
  projectAssignments          ProjectAssignment[]
  taskComments                TaskComment[]
  slaBreaches                 SLABreach[]
  notificationSettings        NotificationSettings[]
  aiChatConversations         AIChatConversation[]
  aiChatMessages              AIChatMessage[]
  projectWorkflows            ProjectWorkflow[]
  workflowStages              WorkflowStage[]
  workflowSteps               WorkflowStep[]
  riskActions                 RiskAction[]
  workflowTemplateStages      WorkflowTemplateStage[]
  workflowTemplateSteps       WorkflowTemplateStep[]
  subscriptionPayments        SubscriptionPayment[]
  retainages                  Retainage[]
  guaranteeLetters            GuaranteeLetter[]
  progressClaims              ProgressClaim[]

  @@index([deletedAt])
}

// Subscription Plans
model Plan {
  id               String               @id @default(cuid())
  name             String
  slug             String               @unique
  nameAr           String? // Arabic name
  description      String?
  descriptionAr    String? // Arabic description
  price            Decimal              @default(0)
  currency         Currency               @default(AED)
  interval         SubscriptionInterval @default(MONTH)
  stripeProductId  String?
  stripePriceId    String?
  features         String               @default("{}") // JSON string for features
  limits           String               @default("{}") // JSON string for limits
  isActive         Boolean              @default(true)
  sortOrder        Int                  @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  subscriptions    Subscription[]
  organizations    Organization[]
}

// Organization Subscriptions
model Subscription {
  id                     String             @id @default(cuid())
  organizationId         String
  planId                 String
  status                 SubscriptionStatus @default(ACTIVE)
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean            @default(false)
  stripeSubscriptionId   String?
  stripeCustomerId       String?
  stripePaymentIntentId  String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  organization           Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                   Plan                  @relation(fields: [planId], references: [id])
  subscriptionPayments   SubscriptionPayment[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([planId])
}

// Subscription Payments (SaaS)
model SubscriptionPayment {
  id                     String        @id @default(cuid())
  subscriptionId         String
  amount                 Decimal       @default(0)
  currency               Currency        @default(AED)
  status                 PaymentStatus @default(PENDING)
  stripePaymentIntentId  String?
  stripeChargeId         String?
  stripeInvoiceId        String?
  receiptUrl             String?
  description            String?
  metadata               String? // JSON string
  organizationId         String? // TODO: Make required after data migration
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  subscription           Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  organization           Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([subscriptionId])
  @@index([status])
  @@index([organizationId])
}

// Email Verification Token
model EmailVerificationToken {
  id         String    @id @default(cuid())
  email      String
  token      String    @unique
  userId     String?
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
  @@index([token])
  @@index([expiresAt])
}

// Password Reset Token
model PasswordResetToken {
  id         String    @id @default(cuid())
  email      String
  token      String    @unique
  userId     String?
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
  @@index([token])
  @@index([expiresAt])
}

// Two-Factor Authentication Secret
model TwoFactorSecret {
  id           String    @id @default(cuid())
  userId       String    @unique
  secret       String // Encrypted TOTP secret
  backupCodes  String // JSON string for backup codes
  isEnabled    Boolean   @default(false)
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
}

// Two-Factor Challenge
model TwoFactorChallenge {
  id         String                 @id @default(cuid())
  userId     String
  code       String
  type       TwoFactorChallengeType @default(TOTP)
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime               @default(now())

  @@index([userId])
  @@index([code])
  @@index([expiresAt])
}

// SLA Breach Tracking
model SLABreach {
  id               String          @id @default(cuid())
  taskId           String
  projectId        String?
  status           SLABreachStatus @default(WARNING)
  daysElapsed      Int             @default(0) // Days since SLA start
  slaDays          Int             @default(0) // Expected SLA days
  breachDays       Int             @default(0) // Days over SLA
  notifiedAt       DateTime? // When notification was sent
  notifiedUsers    String? // JSON array of user IDs notified
  resolvedAt       DateTime? // When breach was resolved
  resolutionNotes  String?
  organizationId   String? // TODO: Make required after data migration
  organization     Organization?   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([taskId])
  @@index([projectId])
  @@index([status])
  @@index([createdAt])
  @@index([organizationId])
}

// User Notification Settings
model NotificationSettings {
  id                  String   @id @default(cuid())
  userId              String   @unique
  emailNotifications  Boolean  @default(true)
  pushNotifications   Boolean  @default(true)
  taskAssigned        Boolean  @default(true)
  taskDueSoon         Boolean  @default(true)
  taskOverdue         Boolean  @default(true)
  invoiceOverdue      Boolean  @default(true)
  projectUpdates      Boolean  @default(true)
  slaWarnings         Boolean  @default(true)
  organizationId      String? // TODO: Make required after data migration
  organization        Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
}

// ==================== AI CHAT PERSISTENCE ====================

/// AI Chat Conversation
model AIChatConversation {
  id              String   @id @default(cuid())
  userId          String
  title           String?
  projectId       String?
  lastMessageAt   DateTime @default(now())
  messageCount    Int      @default(0)
  organizationId  String? // TODO: Make required after data migration
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages        AIChatMessage[]

  @@index([userId])
  @@index([projectId])
  @@index([lastMessageAt])
  @@index([organizationId])
}

/// AI Chat Message
model AIChatMessage {
  id              String   @id @default(cuid())
  conversationId  String
  role            String // 'user' | 'assistant' | 'system'
  content         String
  tokens          Int      @default(0)
  model           String?
  organizationId  String? // TODO: Make required after data migration
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdAt       DateTime @default(now())

  conversation    AIChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@index([organizationId])
}

// ==================== SECURITY AUDIT LOG ====================

/// Security Audit Log for tracking sensitive operations
model SecurityAuditLog {
  id              String   @id @default(cuid())
  userId          String?
  action          SecurityAuditAction // login, logout, 2fa_enable, 2fa_disable, password_change, etc.
  entityType      String?
  entityId        String?
  ipAddress       String?
  userAgent       String?
  details         String? // JSON string for additional details
  status          SecurityAuditResult   @default(SUCCESS) // success, failed, blocked
  errorMessage    String?
  organizationId  String? // TODO: Make required after data migration
  createdAt       DateTime @default(now())

  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([action])
  @@index([status])
  @@index([createdAt])
  @@index([organizationId])
}

// ==================== AUTOMATIONS ====================

model Automation {
  id              String    @id @default(cuid())
  name            String?
  description     String?
  triggerType     AutomationTriggerType?
  triggerConfig   Json?
  actionType      AutomationActionType?
  actionConfig    Json?
  status          AutomationStatus    @default(INACTIVE)
  lastRunAt       DateTime?
  runCount        Int       @default(0)
  organizationId  String? // TODO: Make required after data migration
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([organizationId])
}

// ==================== RETAINAGE MANAGEMENT ====================

/// Retainage tracking for UAE construction projects (5-10% held until completion)
model Retainage {
  id              String    @id @default(cuid())
  organizationId  String? // TODO: Make required after data migration
  projectId       String
  invoiceId       String? // Link to invoice that generated this retainage
  percentage      Decimal   @default(0) // Retainage percentage (e.g. 5, 10)
  retainedAmount  Decimal   @default(0) // Amount retained
  releaseDate     DateTime? // Expected or actual release date
  status          RetainageStatus @default(HELD)
  releasedAmount  Decimal   @default(0) // Amount released so far
  releasedDate    DateTime? // Date of last release
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([status])
  @@index([organizationId])
}

// ==================== GUARANTEE LETTERS ====================

/// Bank guarantees for UAE construction (Performance, Advance Payment, Retention, Bid Bond)
model GuaranteeLetter {
  id               String    @id @default(cuid())
  organizationId   String? // TODO: Make required after data migration
  projectId        String
  type             GuaranteeType @default(PERFORMANCE)
  guaranteeNumber  String? // Bank guarantee reference number
  bankName         String?
  amount           Decimal   @default(0)
  currency         Currency    @default(AED)
  issueDate        DateTime?
  expiryDate       DateTime?
  status           GuaranteeStatus @default(ACTIVE)
  beneficiaryName  String?
  documentUrl      String? // Link to uploaded guarantee document
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  project          Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([type])
  @@index([status])
  @@index([organizationId])
  @@index([expiryDate])
}

// ==================== PROGRESS CLAIMS ====================

/// Monthly progress claims for UAE construction (Interim Payment Applications)
model ProgressClaim {
  id                 String    @id @default(cuid())
  organizationId     String? // TODO: Make required after data migration
  projectId          String
  claimNumber        String? // e.g. "IPC-001"
  period             String? // e.g. "March 2025"
  claimDate          DateTime?
  totalClaimAmount   Decimal   @default(0)
  approvedAmount     Decimal   @default(0)
  previousCertified  Decimal   @default(0) // Cumulative previously certified
  currentCertified   Decimal   @default(0) // Current certification amount
  retentionAmount    Decimal   @default(0) // Retention deducted
  netPayment         Decimal   @default(0) // currentCertified - retentionAmount
  status             ProgressClaimStatus @default(DRAFT)
  certifiedDate      DateTime?
  certifiedById      String? // User who certified
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  project            Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization       Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([status])
  @@index([organizationId])
  @@index([claimNumber])
}

// ==================== TIMESHEETS ====================

model Timesheet {
  id              String    @id @default(cuid())
  employeeId      String
  projectId       String?
  weekStart       DateTime    // Monday of the week
  weekEnd         DateTime    // Sunday of the week
  status          TimesheetStatus @default(DRAFT)
  totalHours      Decimal   @default(0)
  notes           String?
  rejectedReason  String?
  approvedById    String?
  approvedAt      DateTime?
  submittedAt     DateTime?
  organizationId  String? // TODO: Make required after data migration
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  employee        Employee  @relation(fields: [employeeId], references: [id])
  project         Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  approvedBy      User?     @relation("TimesheetApprover", fields: [approvedById], references: [id])
  entries         TimesheetEntry[]

  @@unique([employeeId, weekStart])
  @@index([employeeId, status])
  @@index([projectId])
  @@index([organizationId])
  @@index([deletedAt])
}

model TimesheetEntry {
  id           String   @id @default(cuid())
  timesheetId  String
  date         DateTime
  hours        Decimal
  taskType     TimesheetTaskType?
  description  String?
  projectId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  timesheet    Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([timesheetId])
  @@index([date])
  @@index([projectId])
}
