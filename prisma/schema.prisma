  projectId       String
  authority       GovAuthority @default(MUN)
  status          GovernmentApprovalStatus @default(PENDING)
  submissionDate  DateTime?
  approvalDate    DateTime?
  rejectionCount  Int                      @default(0)
  notes           String?
  organizationId  String? // TODO: Make required after data migration
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([projectId, authority])
  @@index([status])
  @@index([organizationId])
}

// ==================== CLIENTS ====================

model Client {
  id                   String    @id @default(cuid())
  // Basic Info
  clientType           ClientType @default(INDIVIDUAL)
  name                 String
  nameEn               String?
  company              String?
  companyEn            String?
  idNumber             String? // UAE ID or Commercial Registration
  nationality          String?
  idPhoto              String? // ID photo file path
  email                String? // Email uniqueness enforced at application level (many clients may have empty email)
  phone                String?
  whatsapp             String? // separate WhatsApp number
  extraPhone           String? // additional phone
  address              String?
  fullAddress          Json? // JSON: {emirate,city,area,street,building,unit}
  taxNumber            String?
  creditLimit          Decimal   @default(0)
  paymentTerms         String?
  // Services & Project Info
  servicesWanted       Json? // JSON array: ["consultation","design","license",...]
  projectType          ClientProjectType?
  serviceNotes         String? // legacy: additional details
  // Land Details
  landLocation         String?
  landArea             String?
  plotNumber           String?
  planNumber           String?
  landDocuments        Json? // JSON array: [{type:"survey",path:...},...]
  notes                String?
  // Referral
  referralSource       ReferralSource?
  referralDetail       String?
  // Credit & Status
  creditUsed           Decimal   @default(0)
  isActive             Boolean   @default(true)
  organizationId       String // REQUIRED: prevents tenantless data leakage (CWE-284)
  createdById          String?
  deletedAt            DateTime? // Soft delete
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  projects             Project[]
  invoices             Invoice[]
  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contracts            Contract[]
  proposals            Proposal[]
  interactions         ClientInteraction[]
  buildingInspections  BuildingInspection[]

  @@unique([email, organizationId], name: "client_email_org_unique")
  @@unique([idNumber, organizationId], name: "client_idnumber_org_unique")
  @@index([organizationId])
  @@index([email]) // Index for email lookups
  @@index([idNumber]) // Index for ID number lookups
  @@index([deletedAt])
  @@index([isActive])
  @@index([createdById])
}

model ClientInteraction {
  id              String   @id @default(cuid())
  projectId       String
  clientId        String
  type            InteractionType @default(MEETING)
  date            DateTime
  subject         String?
  description     String?
  outcome         String?
  organizationId  String? // TODO: Make required after data migration
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client          Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([clientId])
  @@index([projectId])
  @@index([date])
  @@index([organizationId])
}

// ==================== TASKS ====================

model Task {
  id              String    @id @default(cuid())
  projectId       String?
  title           String?
  titleAr         String?
  description     String?
  assigneeId      String?
  priority        TaskPriority @default(NORMAL)
  status          TaskStatus   @default(TODO)
  startDate       DateTime?
  dueDate         DateTime?
  endDate         DateTime?
  progress        Float     @default(0)
  slaDays         Int?
  slaStartDate    DateTime?
  slaWarningDays  Int       @default(3)
  slaBreachedAt   DateTime?
  taskType        TaskType  @default(STANDARD)
  dependencies    Json? // JSON array of task IDs
  color           String?
  estimatedHours  Float?
  actualHours     Float?
  isMilestone     Boolean   @default(false)
  order           Int       @default(0)
  organizationId  String // REQUIRED: prevents tenantless data leakage (CWE-284)
  createdById     String?
  deletedAt       DateTime? // Soft delete
  parentId        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project         Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee        User?         @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  subtasks        Task[]        @relation("TaskSubtask")
  parent          Task?         @relation("TaskSubtask", fields: [parentId], references: [id])
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  comments        TaskComment[]

  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
  @@index([organizationId])
  @@index([dueDate])
  @@index([projectId, status])
  @@index([assigneeId, status])
  @@index([status, dueDate])
  @@index([deletedAt])
}

// ==================== TASK COMMENTS ====================

model TaskComment {
  id              String   @id @default(cuid())
  content         String
  taskId          String
  userId          String
  organizationId  String? // TODO: Make required after data migration
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  task            Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([organizationId])
}

// ==================== CONTRACTS ====================

model Contract {
  id              String    @id @default(cuid())
  number          String?
  title           String?
  clientId        String
  projectId       String
  value           Decimal   @default(0)
  type            ContractType @default(ENGINEERING_SERVICES)
  status          ContractStatus @default(DRAFT)
  signedByName    String?
  signedByTitle   String?
  signature       String?
  startDate       DateTime?
  deletedAt       DateTime? // Soft delete
  endDate         DateTime?
  organizationId  String // REQUIRED: prevents tenantless data leakage (CWE-284)
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  client          Client              @relation(fields: [clientId], references: [id])
  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  amendments      ContractAmendment[]
  documents       Document[]

  @@index([organizationId])
  @@index([projectId])
  @@index([clientId])
  @@index([deletedAt])
  @@index([status])
}

model ContractAmendment {
  id           String   @id @default(cuid())
  contractId   String
  number       String?
  description  String?
  date         DateTime
  status       AmendmentStatus @default(PENDING)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  contract     Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([status])
}

// ==================== INVOICES ====================

model Invoice {
  id               String    @id @default(cuid())
  number           String    @default(cuid()) // Auto-generated unique number; InvoiceService generates formatted numbers (INV-YYYY-XXXX)
  clientId         String
  projectId        String
  issueDate        DateTime
  dueDate          DateTime
  subtotal         Decimal   @default(0)
  tax              Decimal   @default(0)
  taxRate          Decimal   @default(0) // Tax percentage
  total            Decimal   @default(0)
  paidAmount       Decimal   @default(0)
  remaining        Decimal   @default(0)
  status           InvoiceStatus @default(DRAFT)
  organizationId   String // REQUIRED: prevents tenantless data leakage (CWE-284)
  createdById      String?
  deletedAt        DateTime? // Soft delete
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  client           Client           @relation(fields: [clientId], references: [id])
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items            InvoiceItem[]
  invoicePayments  InvoicePayment[]
  payments         Payment[]
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([number, organizationId], name: "invoice_number_org_unique")
  @@index([clientId])
  @@index([status])
  @@index([projectId])
  @@index([organizationId])
  @@index([deletedAt])
  @@index([dueDate])
}

model InvoiceItem {
  id           String   @id @default(cuid())
  invoiceId    String
  description  String?
  quantity     Decimal  @default(1)
  unitPrice    Decimal  @default(0)
  total        Decimal  @default(0)
  boqItemId    String?
  createdAt    DateTime @default(now())

  invoice      Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([boqItemId])
}

// ==================== INVOICE PAYMENTS ====================

model InvoicePayment {
  id           String   @id @default(cuid())
  invoiceId    String
  paymentId    String
  amount       Decimal  @default(0) // Amount allocated to this invoice
  createdAt    DateTime @default(now())
  createdById  String?

  invoice      Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  payment      Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  creator      User?   @relation(fields: [createdById], references: [id])

  @@index([invoiceId])
  @@index([paymentId])
}

// ==================== PAYMENTS ====================

model Payment {
  id               String   @id @default(cuid())
  voucherNumber    String?
  projectId        String?
  invoiceId        String?
  amount           Decimal  @default(0)
  payMethod        TransactionPayMethod @default(TRANSFER)
  beneficiary      String?
  referenceNumber  String?
  status           PaymentLifecycleStatus @default(PENDING)
  approvedById     String?
  description      String?
  organizationId   String? // TODO: Make required after data migration
  createdById      String?
  updatedById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  invoice          Invoice?         @relation(fields: [invoiceId], references: [id])
  approver         User?            @relation("PaymentApprover", fields: [approvedById], references: [id])
  creator          User?            @relation("PaymentCreator", fields: [createdById], references: [id])
  updater          User?            @relation("PaymentUpdater", fields: [updatedById], references: [id])
  project          Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  organization     Organization?    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoicePayments  InvoicePayment[]

  @@index([organizationId])
  @@index([projectId])
  @@index([status])
  @@index([invoiceId])
  @@index([approvedById])
}

// ==================== PROPOSALS ====================

model Proposal {
  id              String   @id @default(cuid())
  number          String?
  clientId        String
  projectId       String?
  subtotal        Decimal  @default(0)
  tax             Decimal  @default(0)
  total           Decimal  @default(0)
  status          ProposalStatus @default(DRAFT)
