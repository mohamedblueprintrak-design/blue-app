// ==================== RISKS ====================

model Risk {
  id              String   @id @default(cuid())
  projectId       String
  title           String?
  category        RiskCategory @default(TECHNICAL)
  probability     Int      @default(3)
  impact          Int      @default(3)
  score           Int      @default(9)
