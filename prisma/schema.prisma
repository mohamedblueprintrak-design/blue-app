// ==================== USERS & AUTH ====================

model User {
  id                      String    @id @default(cuid())
  email                   String    @unique
  password                String    @default("") // Auth service always hashes passwords before saving; empty default prevents accidental login
  name                    String?   // Nullable — codebase uses fallbacks (e.g., user.name || "المستخدم")
  phone                   String?
  avatar                  String?
  role                    UserRole  @default(VIEWER)
  department              String?
  position                String?
  isActive                Boolean   @default(true)
  lastLogin               DateTime?
  organizationId          String // REQUIRED: prevents tenantless data leakage (CWE-284)
  deletedAt               DateTime? // Soft delete
  // Email verification
  emailVerified           DateTime?
  // NOTE: verifyToken and verifyTokenExpiry fields were removed.
  // Email verification now uses the separate EmailVerificationToken model
  // which stores hashed tokens — never plaintext.
  // Password reset uses the separate PasswordResetToken model.
  passwordChangedAt       DateTime? // When password was last changed - used to invalidate tokens
  // 2FA — the User model's twoFactorEnabled field is kept for quick lookups.
  // The actual secret and backup codes are stored in the TwoFactorSecret model.
  twoFactorEnabled        Boolean   @default(false)
  // NOTE: twoFactorSecret and backupCodes fields were removed from User model.
  // They are now stored exclusively in the TwoFactorSecret model where
  // the secret is AES-256-GCM encrypted and backup codes are SHA-256 hashed.
  // Account lockout
  failedLoginAttempts     Int       @default(0)
  lockedUntil             DateTime?
  // User preferences (accent color, notification settings, etc.) stored as JSON
  preferences             String?   // JSON string: { accentColor, notifications: { projectUpdates, taskDeadlines, ... } }
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  organization            Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  projects                ProjectAssignment[]
  tasks                   Task[]
  assignedDefects         Defect[]
  assignedWorkflowStages  WorkflowStage[]       @relation("WorkflowStageAssignee")
  assignedWorkflowSteps   WorkflowStep[]        @relation("WorkflowStepAssignee")
  activities              ActivityLog[]
  leaves                  Leave[]
  createdProjects         Project[]             @relation("CreatedProjects")
  managedProjects         Project[]             @relation("ProjectManager")
  rfisFrom                RFI[]                 @relation("RFIFrom")
  rfisTo                  RFI[]                 @relation("RFITo")
  riskActions             RiskAction[]
  meetingAttendee         MeetingAttendee[]
  notifications           Notification[]
  sentTransmittals        Transmittal[]         @relation("TransmittalFrom")
  knowledgeArticles       KnowledgeArticle[]
  employee                Employee?
  approvedPayments        Payment[]             @relation("PaymentApprover")
  approvedLeaves          Leave[]               @relation("LeaveApprover")
  uploadedDocuments       Document[]            @relation("DocumentUploader")
  projectComments         ProjectComment[]
  comments                TaskComment[]
  tenders                 Tender[]              @relation("TenderAssignee")
  commissions             Commission[]          @relation("CommissionUser")
  approvedCommissions     Commission[]          @relation("CommissionApprover")
  referrals               Referral[]            @relation("ReferralReferrer")
  notificationSettings    NotificationSettings?
  aiChatConversations     AIChatConversation[]
  refreshTokens           RefreshToken[]
  paymentCreated          Payment[]             @relation("PaymentCreator")
  paymentUpdated          Payment[]             @relation("PaymentUpdater")
  budgetCreated           Budget[]              @relation("BudgetCreator")
  budgetUpdated           Budget[]              @relation("BudgetUpdater")
  proposalCreated         Proposal[]            @relation("ProposalCreator")
  proposalUpdated         Proposal[]            @relation("ProposalUpdater")
  invoicePayments         InvoicePayment[]
  approvedTimesheets      Timesheet[]           @relation("TimesheetApprover")

  @@index([organizationId])
  @@index([deletedAt])
  @@index([name])
  @@index([role])
  @@index([isActive])
}

// ==================== REFRESH TOKENS ====================

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique // SHA-256 hash of the token
  expiresAt  DateTime
  revokedAt  DateTime? // When token was explicitly revoked
  createdAt  DateTime  @default(now())

  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

// ==================== COMPANY SETTINGS ====================

model CompanySettings {
  id              String   @id @default(cuid())
  name            String   @default("مكتب الاستشارات الهندسية")
  nameEn          String   @default("Engineering Consultancy Office")
  logo            String?
  email           String?
  phone           String?
  address         String?
  taxNumber       String?
  currency        Currency @default(AED)
  timezone        String   @default("Asia/Dubai")
  workingDays     String   @default("sat,sun,mon,tue,wed,thu") // comma-separated UAE work week (Saturday-Thursday)
  workingHours    String   @default("08:00-17:00")
  organizationId  String // REQUIRED: prevents tenantless data leakage (CWE-284)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
}

// ==================== PROJECTS ====================

model Project {
  id                          String    @id @default(cuid())
  number                      String
  name                        String
  nameEn                      String?
  clientId                    String
  contractorId                String?
  location                    String?
  latitude                    Float?
  longitude                   Float?
  plotNumber                  String?
  type                        ProjectType @default(VILLA)
  status                      ProjectStatus @default(ACTIVE)
  progress                    Float     @default(0)
  budget                      Decimal   @default(0)
  contractValue               Decimal   @default(0) // Total contract value
  paymentMethod               PaymentMethod?
  paymentSchedule             Json?
  expectedDuration            Int       @default(0) // Expected duration in days
  startDate                   DateTime?
  endDate                     DateTime?
  expectedEndDate             DateTime? // Expected delivery date
  actualStartDate             DateTime?
  actualEndDate               DateTime?
  contractDate                DateTime?
  description                 String?
  municipalityChecklist       Json?
  managerId                   String?
  createdById                 String
  organizationId              String // REQUIRED: prevents tenantless data leakage (CWE-284)
  deletedAt                   DateTime? // Soft delete
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  client                      Client                       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  contractor                  Contractor?                  @relation("ProjectContractor", fields: [contractorId], references: [id], onDelete: SetNull)
  createdBy                   User                         @relation("CreatedProjects", fields: [createdById], references: [id], onDelete: Restrict)
  manager                     User?                        @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  organization                Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignments                 ProjectAssignment[]
  tasks                       Task[]
  stages                      ProjectStage[]
  muniRejections              MunicipalRejection[]
  govApprovals                GovApproval[]
  boqItems                    BOQItem[]
  schedulePhases              SchedulePhase[]
  invoices                    Invoice[]
  contracts                   Contract[]
  proposals                   Proposal[]
  bids                        Bid[]
  budgets                     Budget[]
  commissions                 Commission[]
  referrals                   Referral[]
  siteVisits                  SiteVisit[]
  defects                     Defect[]
  siteDiaries                 SiteDiary[]
  rfis                        RFI[]
  submittals                  Submittal[]
  changeOrders                ChangeOrder[]
  transmittals                Transmittal[]
  risks                       Risk[]
  meetings                    Meeting[]
  clientInteractions          ClientInteraction[]
  documents                   Document[]
  purchaseOrders              PurchaseOrder[]
  inventoryItems              InventoryItem[]
  payments                    Payment[]
  comments                    ProjectComment[]
  municipalityCorrespondence  MunicipalityCorrespondence[]
  approvals                   Approval[]
  notifications               Notification[]
  activityLogs                ActivityLog[]
  knowledgeArticles           KnowledgeArticle[]
  designPhases                DesignPhase[]
  buildingInspections         BuildingInspection[]
  supervisionChecklists       SupervisionChecklist[]
  violations                  Violation[]
  workflow                    ProjectWorkflow?
  retainages                  Retainage[]
  guaranteeLetters            GuaranteeLetter[]
  progressClaims              ProgressClaim[]
  timesheets                  Timesheet[]
  timesheetEntries            TimesheetEntry[]

  @@unique([number, organizationId])
  @@index([clientId])
  @@index([status])
  @@index([contractorId])
  @@index([organizationId])
  @@index([deletedAt])
  @@index([createdById])
  @@index([managerId])
}

// ==================== MUNICIPALITY CORRESPONDENCE ====================

model MunicipalityCorrespondence {
  id                  String    @id @default(cuid())
  projectId           String
  referenceNumber     String?
  municipality        Municipality?
  correspondenceType  CorrespondenceType @default(SUBMISSION)
  subject             String?
  content             String?
  submissionDate      DateTime?
  responseDate        DateTime?
  status              CorrespondenceStatus @default(PENDING)
  notes               String?
  responseNotes       String?
  organizationId      String? // TODO: Make required after data migration
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  project             Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization        Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([status])
  @@index([organizationId])
}

model ProjectComment {
  id              String   @id @default(cuid())
  content         String
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId  String? // TODO: Make required after data migration
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([projectId])
  @@index([organizationId])
}

model ProjectAssignment {
  id              String   @id @default(cuid())
  projectId       String
  userId          String
  role            ProjectAssignmentRole @default(TEAM_MEMBER)
  organizationId  String? // TODO: Make required after data migration
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project         Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([organizationId])
}

