  organization    Organization?  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  items           ProposalItem[]

  @@index([organizationId])
  @@index([projectId])
  @@index([clientId])
  @@index([status])
}

model ProposalItem {
  id           String   @id @default(cuid())
  proposalId   String
  description  String?
  quantity     Decimal  @default(1)
  unitPrice    Decimal  @default(0)
  total        Decimal  @default(0)
  createdAt    DateTime @default(now())

  proposal     Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
}

// ==================== CONTRACTORS ====================

model Contractor {
  id                  String    @id @default(cuid())
  name                String?
  nameEn              String?
  companyName         String?
  companyEn           String?
  contactPerson       String?
  phone               String?
  email               String?
  address             String?
  crNumber            String? // Commercial Registration; uniqueness enforced at application level when not empty
  licenseNumber       String?
  licenseExpiry       DateTime?
  classification      String? // Contractor classification level (e.g., "الدرجة الثالثة")
  establishmentDate   DateTime? // Company establishment date
  workerCount         Int?      @default(0) // Number of workers
  engineerCount       Int?      @default(0) // Number of engineers
  tradeLicense        String? // Trade license number
  tradeLicenseExpiry  DateTime? // Trade license expiry date
  vatNumber           String? // VAT registration number
  category            ContractorCategory?
  rating              Int       @default(0) // 1-5 stars
  specialties         String? // comma-separated specialties
  experience          String? // years of experience description
  bankName            String?
  bankAccount         String?
  iban                String?
  isActive            Boolean   @default(true)
  notes               String?
  organizationId      String // REQUIRED: prevents tenantless data leakage (CWE-284)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  projects            Project[]              @relation("ProjectContractor")
  bids                Bid[]
  evaluations         ContractorEvaluation[]
  organization        Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([crNumber, organizationId], name: "contractor_cr_org_unique")
  @@index([crNumber]) // Index for CR number lookups
  @@index([organizationId])
}

// ==================== CONTRACTOR EVALUATION ====================

model ContractorEvaluation {
  id              String   @id @default(cuid())
  contractorId    String
  projectId       String
  criteria        String? // experience, financial, technical, past_performance, resources
  score           Int      @default(0) // 0-100
  maxScore        Int      @default(100)
  weight          Decimal  @default(1) // percentage weight for this criteria
  notes           String?
  evaluatedBy     String?
  bidId           String?
  organizationId  String? // TODO: Make required after data migration
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  contractor      Contractor    @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  bid             Bid?          @relation(fields: [bidId], references: [id])
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([bidId])
  @@index([contractorId])
  @@index([organizationId])
}

// ==================== BIDS ====================

model Bid {
  id                 String    @id @default(cuid())
  projectId          String
  contractorId       String?
  contractorName     String?
  contractorContact  String?
  amount             Decimal   @default(0)
  technicalScore     Int       @default(0)
  financialScore     Int       @default(0)
  totalScore         Decimal   @default(0)
  status             BidStatus @default(SUBMITTED)
  deadline           DateTime?
  notes              String?
  evaluationNotes    String?
  quoteFile          String?
  quoteUploadedAt    DateTime?
  rfqSentAt          DateTime?
  rfqStatus          RFQStatus @default(PENDING)
  aiAnalysis         String?
  contractFile       String?
  contractSignedAt   DateTime?
  isAwarded          Boolean   @default(false)
  organizationId     String? // TODO: Make required after data migration
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  project            Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractor         Contractor?            @relation(fields: [contractorId], references: [id])
  organization       Organization?          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  evaluations        ContractorEvaluation[]

  @@index([projectId])
  @@index([contractorId])
  @@index([organizationId])
  @@index([status])
}

// ==================== BUDGETS ====================

model Budget {
  id              String   @id @default(cuid())
  projectId       String
  parentId        String?
  name            String?
  category        String? // overall, architectural, structural, electrical, mep
  planned         Decimal  @default(0)
  actual          Decimal  @default(0)
  committed       Decimal  @default(0)
  remaining       Decimal  @default(0)
  deviation       Decimal  @default(0)
  organizationId  String? // TODO: Make required after data migration
  createdById     String?
  updatedById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent          Budget?       @relation("BudgetHierarchy", fields: [parentId], references: [id])
  children        Budget[]      @relation("BudgetHierarchy")
  creator         User?         @relation("BudgetCreator", fields: [createdById], references: [id])
  updater         User?         @relation("BudgetUpdater", fields: [updatedById], references: [id])
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([projectId])
  @@index([parentId])
}

